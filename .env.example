# ---------------------------------------------------------------------------
# Assisty — environment variables (copy to .env and fill in). NO real secrets.
# A single .env at the repo root is consumed by docker-compose (api service)
# and by the backend at runtime.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# Inside docker-compose, use @postgres:5432 (service name). From the host
# (e.g. running `npm run migrate` locally) use @localhost:5432.
DATABASE_URL=postgresql://assisty:assisty@postgres:5432/assisty

# Compose-only Postgres bootstrap credentials (used by the postgres service).
POSTGRES_USER=assisty
POSTGRES_PASSWORD=assisty
POSTGRES_DB=assisty

# --- LiteLLM proxy ---------------------------------------------------------
# Backend talks to LiteLLM (OpenAI-compatible). Inside compose use the service
# name; in prod point at your hosted LiteLLM or directly at OpenRouter.
LITELLM_BASE_URL=http://litellm:4000/v1
# Must match LITELLM_MASTER_KEY below (LiteLLM authenticates clients with it).
LITELLM_API_KEY=sk-litellm-master-change-me

# --- AI models -------------------------------------------------------------
DEFAULT_CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- AI provider keys (consumed by the LiteLLM container) ------------------
OPENAI_API_KEY=sk-openai-placeholder
GEMINI_API_KEY=gemini-api-key-placeholder
OPENROUTER_API_KEY=sk-or-placeholder
# Master key clients must present to LiteLLM. Keep in sync with LITELLM_API_KEY.
LITELLM_MASTER_KEY=sk-litellm-master-change-me

# --- WhatsApp Cloud API ----------------------------------------------------
# Token you set in the Meta webhook config; echoed back during GET verify.
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
# App secret used to validate the X-Hub-Signature-256 HMAC on POST webhooks.
WHATSAPP_APP_SECRET=change-me-app-secret
WHATSAPP_GRAPH_VERSION=v21.0
# Optional single-tenant dev fallback. In production these live per-tenant in
# the channel_connections table, NOT here.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
